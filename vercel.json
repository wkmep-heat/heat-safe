{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/notify", "schedule": "*/30 * * * *" },
    { "path": "/api/notify-water", "schedule": "*/30 * * * *" }
  ]
}
